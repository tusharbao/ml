# sklearn.datasets मधून load_digits dataset import करतो.
# या dataset मध्ये handwritten digits (0 ते 9) चे images असतात.
from sklearn.datasets import load_digits

# Dataset ला training आणि testing parts मध्ये divide करण्यासाठी function import करतो.
from sklearn.model_selection import train_test_split

# Support Vector Classifier (SVC) import करतो, जो classification साठी वापरला जातो.
from sklearn.svm import SVC

# Model ची accuracy आणि classification report calculate करण्यासाठी functions import करतो.
from sklearn.metrics import accuracy_score, classification_report

# Images display करण्यासाठी Matplotlib library import करतो.
import matplotlib.pyplot as plt


# Digits dataset load करतो आणि digits variable मध्ये store करतो.
digits = load_digits()


# Dataset मधील image data X मध्ये store करतो.
# प्रत्येक 8x8 image चे 64 pixel values असतात.
X = digits.data

# Dataset मधील actual digit labels y मध्ये store करतो.
# Labels 0 ते 9 पर्यंत असतात.
y = digits.target


# Dataset मधील पहिला handwritten digit image display करतो.
# cmap='gray' मुळे image black and white मध्ये दिसतो.
plt.imshow(digits.images[0], cmap='gray')

# Image चा actual digit title मध्ये display करतो.
# str(y[0]) मुळे digit number string मध्ये convert होतो.
plt.title("Digit: " + str(y[0]))

# Image screen वर display करतो.
plt.show()


# Dataset ला training आणि testing data मध्ये divide करतो.
X_train, X_test, y_train, y_test = train_test_split(

    # Input features training आणि testing साठी देतो.
    X,

    # Actual output labels training आणि testing साठी देतो.
    y,

    # 20% data testing साठी आणि 80% training साठी ठेवतो.
    test_size=0.2,

    # प्रत्येक वेळी same random split मिळण्यासाठी random_state वापरतो.
    random_state=42,

    # प्रत्येक digit class चे proportion training आणि testing मध्ये maintain करतो.
    stratify=y
)


# SVC म्हणजे Support Vector Classifier चे object तयार करतो.
# kernel='rbf' मुळे Radial Basis Function kernel वापरला जातो.
model = SVC(kernel='rbf')


# Training data वापरून SVM model train करतो.
model.fit(X_train, y_train)


# Testing data वर prediction करून predicted digit labels y_pred मध्ये store करतो.
y_pred = model.predict(X_test)


# Actual आणि predicted values compare करून model ची accuracy calculate करतो.
accuracy = accuracy_score(y_test, y_pred)

# Model ची accuracy display करतो.
print("Accuracy:", accuracy)


# Classification report display करण्यासाठी heading print करतो.
print("\nClassification Report:")

# Precision, Recall, F1-score आणि Support calculate करून display करतो.
print(classification_report(y_test, y_pred))


# Testing dataset मधील पहिल्या 5 images साठी loop execute करतो.
for i in range(5):

    # Testing data मधील image 8x8 format मध्ये reshape करून display करतो.
    # cmap='gray' मुळे image black and white मध्ये दिसतो.
    plt.imshow(X_test[i].reshape(8, 8), cmap='gray')

    # Actual digit आणि model ने predict केलेला digit title मध्ये दाखवतो.
    # format() function वापरून values title मध्ये insert करतो.
    plt.title("Actual: {}  Predicted: {}".format(
        y_test[i], y_pred[i]
    ))

    # प्रत्येक image screen वर display करतो.
    plt.show()
















