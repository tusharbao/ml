# Pandas library import करतो, जी dataset read आणि data manipulation करण्यासाठी वापरली जाते.
import pandas as pd

# PCA class import करतो, जी dimensionality reduction करण्यासाठी वापरली जाते.
from sklearn.decomposition import PCA

# StandardScaler import करतो, जो data ला standard scale वर convert करतो.
from sklearn.preprocessing import StandardScaler

# Matplotlib library import करतो, जी graphs आणि plots तयार करण्यासाठी वापरली जाते.
import matplotlib.pyplot as plt


# Wine.csv ही dataset CSV file मधून read करून df मध्ये store करतो.
df = pd.read_csv(r"C:\Users\Software Lab-12\Downloads\Wine.csv")


# Dataset मधील सर्व column names print करतो.
print(df.keys())

# Customer_Segment column मधील unique values म्हणजे वेगवेगळे classes print करतो.
print(df.Customer_Segment.unique())

# Dataset मधील प्रत्येक column मध्ये किती missing values आहेत ते check करतो.
print(df.isnull().sum())


# Customer_Segment हा target column सोडून बाकी सर्व columns X मध्ये store करतो.
X = df.drop('Customer_Segment', axis=1)

# Customer_Segment हा target column y मध्ये store करतो.
y = df['Customer_Segment']


# StandardScaler चे object तयार करतो.
sc = StandardScaler()

# सर्व features standardize करतो.
# म्हणजे data ची mean 0 आणि standard deviation 1 होते.
X = sc.fit_transform(X)


# PCA चे object तयार करतो.
# येथे सुरुवातीला सर्व possible principal components calculate होतील.
pca = PCA()

# PCA algorithm apply करून original data चे reduced components मध्ये transformation करतो.
X_pca = pca.fit_transform(X)


# प्रत्येक principal component किती variance explain करतो ते calculate करतो.
explained_variance_ratio = pca.explained_variance_ratio_


# Cumulative explained variance चा graph plot करतो.
plt.plot(

    # X-axis वर principal components ची संख्या दाखवतो.
    range(1, len(explained_variance_ratio) + 1),

    # प्रत्येक component चे explained variance add करून cumulative variance calculate करतो.
    explained_variance_ratio.cumsum(),

    # प्रत्येक data point वर circle marker दाखवतो.
    marker='o',

    # Graph मध्ये dashed line दाखवतो.
    linestyle='--'
)

# X-axis ला label देतो.
plt.xlabel('Number of Principal Components')

# Y-axis ला label देतो.
plt.ylabel('Cumulative Explained Variance')

# Graph ला title देतो.
plt.title('Explained Variance Ratio')

# तयार केलेला graph screen वर display करतो.
plt.show()


