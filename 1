pca = PCA(n_components=n_components)

# PCA पुन्हा apply करून data चे 12 dimensions मध्ये conversion करतो.
X_pca = pca.fit_transform(X)


# Red Wine म्हणजे class 1 असणाऱ्या rows चे index मिळवतो.
red_indices = y[y == 1].index

# White Wine म्हणजे class 2 असणाऱ्या rows चे index मिळवतो.
