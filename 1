    X_pca[red_indices, 0],

    # X_pca मधील दुसरा principal component Y-axis वर दाखवतो.
    X_pca[red_indices, 1],

    # Red Wine साठी red colour वापरतो.
    c='red',

    # Graph मध्ये Red Wine हे label दाखवतो.
    label='Red Wine'
)

# White Wine चा scatter plot तयार करतो.
plt.scatter(

    # White Wine चा पहिला principal component X-axis वर दाखवतो.
    X_pca[white_indices, 0],

    # White Wine चा दुसरा principal component Y-axis वर दाखवतो.
