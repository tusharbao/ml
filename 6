import numpy as np  # Mathematical operations आणि Q-table तयार करण्यासाठी NumPy import केले


class TicTacToeEnvironment:  # Tic-Tac-Toe game चे environment तयार करणारा class
    def __init__(self):  # Object तयार झाल्यावर automatically execute होणारी method
        self.state = [0] * 9  # 3x3 board तयार केला; 0 म्हणजे empty cell
        self.is_terminal = False  # Game संपला आहे की नाही हे check करण्यासाठी

    def reset(self):  # Game पुन्हा सुरुवातीपासून सुरू करण्यासाठी method
        self.state = [0] * 9  # सर्व 9 cells पुन्हा empty केले
