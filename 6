    def is_draw(self):  # Game draw झाला आहे का हे check करण्यासाठी
        return 0 not in self.state  # Board मध्ये एकही empty cell नसेल तर True return केले


class QLearningAgent:  # Q-Learning वापरणारा agent तयार करणारा class
    def __init__(
        self,
        learning_rate=0.9,  # नवीन अनुभवातून किती शिकायचे हे ठरवणारा parameter
        discount_factor=0.9,  # Future rewards ला किती importance द्यायचे
        exploration_rate=0.3  # नवीन moves try करण्याची probability
    ):
        self.learning_rate = learning_rate  # Learning rate store केला
        self.discount_factor = discount_factor  # Discount factor store केला
        self.exploration_rate = exploration_rate  # Exploration rate store केला
        self.q_table = np.zeros((3**9, 9))  # सर्व possible states आणि 9 actions साठी Q-table तयार केली; सुरुवातीला सर्व values 0

    def get_state_index(self, state):  # Board state ला एक unique numerical index देण्यासाठी
        state_index = 0  # सुरुवातीला index 0 ठेवला
        for i, mark in enumerate(state):  # Board मधील प्रत्येक cell आणि त्याचा index check केला
            state_index += (3 ** i) * (mark + 1)  # प्रत्येक cell चा mark वापरून unique index calculate केला
        return state_index  # Calculated state index return केला

    def choose_action(self, state, available_moves):  # Agent ने कोणती move करावी हे ठरवण्यासाठी
        state_index = self.get_state_index(state)  # Current state चा Q-table index मिळवला
        if np.random.random() < self.exploration_rate:  # Exploration probability satisfy झाली तर
            return np.random.choice(available_moves)  # Available moves मधून random move निवडली
        else:  # अन्यथा exploitation करायचे
            return np.argmax(self.q_table[state_index, available_moves])  # Available moves पैकी highest Q-value असलेली move निवडली

    def update_q_table(self, state, action, next_state, reward):  # नवीन experience नुसार Q-table update करण्यासाठी
        state_index = self.get_state_index(state)  # Current state चा index मिळवला
        if next_state is not None:  # पुढील state available असेल तर
            next_state_index = self.get_state_index(next_state)  # Next state चा index मिळवला
            max_q_value = np.max(self.q_table[next_state_index])  # Next state मधील maximum Q-value मिळवली
        else:  # पुढील state नसेल म्हणजे terminal state असेल तर
            max_q_value = 0  # Future Q-value 0 ठेवली

        self.q_table[state_index, action] = (  # Current state-action ची Q-value update केली
            (1 - self.learning_rate)  # जुन्या Q-value चा remaining weight
            * self.q_table[state_index, action]  # जुन्या Q-value ला weight दिले
            +
            self.learning_rate  # नवीन experience चा weight
            * (
                reward  # मिळालेला immediate reward
                + self.discount_factor * max_q_value  # Discounted future reward add केला
            )
        )


