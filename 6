        self.state[move] = player_mark  # दिलेल्या position वर player चा mark ठेवला

    def check_win(self, player_mark):  # Player जिंकला आहे का हे check करण्यासाठी
        winning_states = [  # जिंकण्यासाठी लागणाऱ्या सर्व possible combinations
            [0, 1, 2],  # पहिली horizontal row
            [3, 4, 5],  # दुसरी horizontal row
            [6, 7, 8],  # तिसरी horizontal row
            [0, 3, 6],  # पहिली vertical column
            [1, 4, 7],  # दुसरी vertical column
            [2, 5, 8],  # तिसरी vertical column
            [0, 4, 8],  # Left-to-right diagonal
            [2, 4, 6]   # Right-to-left diagonal
        ]
        for state_indices in winning_states:  # प्रत्येक winning combination check करण्यासाठी loop
            if all(self.state[i] == player_mark for i in state_indices):  # तीनही positions वर same player's mark आहे का ते check केले
